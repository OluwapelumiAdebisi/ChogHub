# testnet | mainnet
NETWORK=testnet
# web3 = real chain; fake = in-memory chain for local UI work (no RPC, no wallet tx needed)
CHAIN_MODE=fake
# Optional: a paid RPC to avoid public rate limits
RPC_URL=

# From `forge script script/Deploy.s.sol` output
CHOG_NFT_ADDRESS=
CHOG_TOKEN_ADDRESS=
CHOG_VENDOR_ADDRESS=
CHOG_REGISTRY_ADDRESS=

# Backend signer that writes reputation to ChogRegistry. Testnet-only key with a little MON.
ATTESTER_PRIVATE_KEY=

DATABASE_URL=sqlite:///./choghub.db
JWT_SECRET=replace-with-a-long-random-string
# Must equal the host the frontend runs on (what appears in the SIWE message)
SIWE_DOMAIN=localhost:3000
CORS_ORIGINS=http://localhost:3000
# Wallets allowed into /admin, comma-separated
ADMIN_WALLETS=

# Leave empty to use the built-in rules agent (no LLM)
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5

MAX_SPEND_MON=5
SLIPPAGE_BPS=100
